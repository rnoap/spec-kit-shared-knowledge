# .extensionignore — patterns excluded when `specify extension add` copies
# this extension into a consumer project. Format follows .gitignore syntax.

# Spec Kit dev artifacts (specs for this extension itself)
specs/
AGENTS.md
CHANGELOG.md

# Code knowledge graph (local dev tool state)
.code-review-graph/

# Local tool / editor state
.specify/
.claude/
.wibey/
.vscode/
.idea/

# Agent command/prompt surfaces generated for THIS repo's own spec-kit workspace.
# These belong to other extensions (git, brownfield, companion) — copying them
# into a consumer project would install ~86 unrelated files.
.github/

# Version control
.git/
.gitattributes
.gitignore

# OS junk
.DS_Store
Thumbs.db
*.swp
*.tmp
